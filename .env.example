# Storyblok access token. Production builds use the public token; the preview branch uses the preview token.
STORYBLOK_DELIVERY_API_TOKEN=<REPLACE_WITH_YOUR_TOKEN>
STORYBLOK_REGION=eu
# "published" (default): flat HTML of published content. "draft": client-rendered SPA for the Visual Editor.
STORYBLOK_VERSION=published
SITE_URL=https://martinalcock.co.uk
